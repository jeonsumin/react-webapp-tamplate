{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",

    "typeRoots": ["node_modules/@types", "types/"],
    "baseUrl": "./src",
    "paths": {
      "@": ["./src/*"],
      "app/*": ["./app/*"],
      "pages/*": ["./pages/*"],
      "widgets/*": ["./widgets/*"],
      "features/*": ["./features/*"],
      "entities/*": ["./entities/*"],
      "shared/*": ["./shared/*"],
    }
  },
  "include": ["src", "eslint.config.ts", "vite-env.d.ts", "vite.config.ts"]
}
